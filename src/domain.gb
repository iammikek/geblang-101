## Domain error with HTTP status and optional machine-readable code.
export class DomainError extends Error {
    string detail;
    string code;
    int status;

    func DomainError(string detail, string code, int status) {
        parent(detail);
        this.detail = detail;
        this.code = code;
        this.status = status;
    }
}

export class ValidationError extends DomainError {
    func ValidationError(string detail) {
        parent(detail, "", 422);
    }
}

export class UnauthorizedError extends DomainError {
    func UnauthorizedError(string detail) {
        parent(detail, "", 401);
    }
}

export class ItemNotFoundError extends DomainError {
    func ItemNotFoundError(int itemId) {
        parent("Item not found", "ITEM_NOT_FOUND", 404);
    }
}

export class CategoryNotFoundError extends DomainError {
    func CategoryNotFoundError(int categoryId) {
        parent("Category not found", "CATEGORY_NOT_FOUND", 404);
    }
}

export class CategoryNameExistsError extends DomainError {
    func CategoryNameExistsError(string name) {
        parent("Category name '" + name + "' already exists", "CATEGORY_NAME_EXISTS", 409);
    }
}

export class CategoryInUseError extends DomainError {
    func CategoryInUseError() {
        parent("Category has items and cannot be deleted", "CATEGORY_IN_USE", 409);
    }
}

export class UserEmailExistsError extends DomainError {
    func UserEmailExistsError(string email) {
        parent("User email '" + email + "' already exists", "USER_EMAIL_EXISTS", 409);
    }
}
